#!/usr/bin/env python3
"""Stream the Hyprland cursor position on stdout, one "x y" line per change.

Hyprland has no cursor-move event to subscribe to and Quickshell exposes no
pointer position, so the position has to be sampled. Shelling out to `hyprctl`
costs ~8ms per sample — about 8% of a core at 10Hz, which is far too much to
spend on Pebble. Talking to the Hyprland socket directly costs ~0.03ms, so that
is what this does: the same request `hyprctl` makes, without paying for a
process launch each time.

The sample rate is controlled by the reader: write a millisecond interval on
stdin and this adjusts. The plugin slows it right down while the cat sleeps and
speeds it up when the cat is awake, so an idle desktop costs close to nothing.

Lifetime is tied to the parent process by PR_SET_PDEATHSIG, so this cannot
outlive the shell that started it even if nobody ever reads or writes to it.
"""

import os
import select
import signal
import socket
import sys
import time

DEFAULT_INTERVAL_MS = 100
MIN_INTERVAL_MS = 20
MAX_INTERVAL_MS = 2000


def socket_path():
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not signature:
        return None
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        return None
    path = os.path.join(runtime, "hypr", signature, ".socket.sock")
    return path if os.path.exists(path) else None


def sample(path):
    """Ask Hyprland where the cursor is. Returns (x, y) or None."""
    try:
        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        connection.settimeout(0.5)
        connection.connect(path)
        connection.sendall(b"cursorpos")
        raw = connection.recv(64)
        connection.close()
    except OSError:
        return None
    try:
        x, y = raw.decode("utf-8", "replace").strip().split(",")
        return int(x), int(y)
    except ValueError:
        return None


def die_with_parent():
    """Ask the kernel to kill us when our parent goes away.

    Lifetime used to hang off stdin reaching EOF, which was wrong twice over: a
    closed stdin is permanently *readable*, so the daemon exited after a single
    sample, and it exited immediately when run with stdin at /dev/null. This is
    the right mechanism — it does not care whether anyone ever writes to us.
    """
    try:
        import ctypes
        PR_SET_PDEATHSIG = 1
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGTERM)
    except Exception:
        pass


def read_interval(current, stdin_open):
    """Drain any pending interval requests from stdin.

    Returns (interval, stdin_open). Losing stdin only means nobody can retune
    the sample rate any more; it is not a reason to stop reporting.
    """
    while stdin_open:
        ready, _, _ = select.select([sys.stdin], [], [], 0)
        if not ready:
            return current, True
        line = sys.stdin.readline()
        if line == "":
            return current, False
        line = line.strip()
        if not line:
            continue
        try:
            current = max(MIN_INTERVAL_MS, min(MAX_INTERVAL_MS, int(float(line))))
        except ValueError:
            pass
    return current, False


def main():
    path = socket_path()
    if path is None:
        print("pebble-cursor: no Hyprland socket", file=sys.stderr)
        return 1

    die_with_parent()

    interval = DEFAULT_INTERVAL_MS
    stdin_open = True
    last = None
    while True:
        interval, stdin_open = read_interval(interval, stdin_open)

        position = sample(path)
        if position is None:
            # Hyprland went away (or is restarting). Back off rather than spin.
            time.sleep(1.0)
            continue

        if position != last:
            last = position
            sys.stdout.write(f"{position[0]} {position[1]}\n")
            sys.stdout.flush()

        time.sleep(interval / 1000.0)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        # Our reader went away. Point stdout at /dev/null so the interpreter's
        # shutdown flush does not raise a second time on the way out.
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except OSError:
            pass
        sys.exit(0)
